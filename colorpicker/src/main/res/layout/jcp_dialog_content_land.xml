<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <!-- Landscape: everything on one row so the preview and hex field stay visible. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="horizontal">

        <com.jardy.colorpicker.SaturationValueView
            android:id="@+id/jcp_sat_val"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:contentDescription="@string/jcp_saturation_value" />

        <com.jardy.colorpicker.HueBarView
            android:id="@+id/jcp_hue"
            android:layout_width="36dp"
            android:layout_height="160dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/jcp_hue" />

        <com.jardy.colorpicker.AlphaBarView
            android:id="@+id/jcp_alpha"
            android:layout_width="36dp"
            android:layout_height="160dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/jcp_alpha" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.jardy.colorpicker.ColorPreviewView
                android:id="@+id/jcp_preview"
                android:layout_width="72dp"
                android:layout_height="36dp" />

            <EditText
                android:id="@+id/jcp_hex"
                style="@style/JardyColorPicker.Hex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/jcp_hex_hint"
                android:importantForAutofill="no" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
